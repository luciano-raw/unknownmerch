generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid()) // Will store the Clerk User ID
  email     String   @unique
  role      String   @default("user") // "user" or "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  description      String
  price            Float
  category         String   // "stickers", "apparel" or "accessories"
  images           String[]
  specifications   Json?    
  shippingDetails  String?
  stock            Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  customerName String?
  customerPhone String?
  total     Float
  status    String      @default("pending") // "pending", "whatsapp_sent", "completed"
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model StoreSettings {
  id                 String   @id @default("global")
  heroBannerUrl      String?  
  bannerIsActive     Boolean  @default(false)
  storeNotice        String?  
  whatsappNumber     String   @default("56930531304")
  updatedAt          DateTime @updatedAt
}

model Vehicle {
  id            String   @id @default(cuid())
  brand         String
  model         String
  year          Int
  suspension    String   // 'Stock', 'Neumática', 'Coilovers', 'Static', 'No aplica'
  instagram     String?
  description   String
  images        String[]
  imagePosition String   @default("center")
  status        String   @default("Community") // "Community" or "Club Member"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  type         String   // "pageview" or "click"
  path         String   // e.g. "/product/xyz" or "/"
  elementId    String?  // e.g. "add-to-cart", "instagram-link"
  elementText  String?  // e.g. "Polera Black", "JR3 Wheels"
  sessionToken String   // to identify unique visits / sessions
  duration     Int?     // duration in seconds (for pageview exit tracking)
  deviceType   String?  // "mobile" or "desktop"
  createdAt    DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   // User Clerk ID
  userEmail   String   // User email (to easily display it in the list)
  action      String   // e.g., "CREATE_PRODUCT", "UPDATE_SETTINGS", "DELETE_VEHICLE", "VIP_DISCOUNT_UPDATE", "STOCK_UPDATE"
  description String   // Detailed message e.g., "Creado producto 'Polera Unknown' con precio $15000"
  createdAt   DateTime @default(now())
}

